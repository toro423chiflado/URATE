# ================================================================
# URATE — .env.example
# Copiar como .env y completar con tus valores reales
# ================================================================

# ── IPs de MV3 (bases de datos) ───────────────────────────────
DB_HOST=10.0.1.10   # IP privada de MV3

# ── PostgreSQL (MS1 - Users) ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres_secure_2025@${DB_HOST}:5432/auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2025

# ── MySQL (MS2 - Academic) ────────────────────────────────────
MYSQL_URL=jdbc:mysql://${DB_HOST}:3306/academic_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=utec_user
MYSQL_PASS=utec_pass_2025
MYSQL_ROOT_PASSWORD=root_utec_2025

# ── MongoDB (MS3 - Reviews) ───────────────────────────────────
MONGO_URL=mongodb://${DB_HOST}:27017

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_algo_muy_secreto_2025
JWT_REFRESH_SECRET=cambia_esto_por_algo_diferente_2025

# ── AWS (MS5 - Analytics) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY
AWS_SESSION_TOKEN=TU_SESSION_TOKEN   # solo si usas credenciales temporales (Academy)
AWS_REGION=us-east-1
S3_BUCKET=utecrate-analytics-data
ATHENA_DATABASE=utecrate
ATHENA_OUTPUT=s3://utecrate-analytics-data/athena-results/
